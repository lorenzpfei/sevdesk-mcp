{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/well-known" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/well-known" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/well-known" }
  ]
}
