# sevdesk-mcp — local development configuration.
#
# Copy to `.env` and fill in your token. Used only for runs outside an MCP
# client (`npm run dev`, `node dist/index.js`). When your MCP client passes
# these through its own `env` block, that block wins over this file.
#
# `.env` is gitignored. Your sevDesk token has no scopes — it can do
# everything your login can — so treat it like a password.

# Required. sevDesk: Settings -> Users -> your user -> API (32-char hex).
SEVDESK_API_TOKEN=

# Strongly recommended while developing: hide the write tools entirely.
SEVDESK_READ_ONLY=true

# Show what a write *would* send, without sending it.
# SEVDESK_DRY_RUN=false

# regular | kleinunternehmer | auto (default: auto, inferred from the ledger)
# SEVDESK_VAT_REGIME=auto

# Colon-separated allowlist of directories the receipt file tools may touch.
# Unset means the file tools stay disabled.
# SEVDESK_RECEIPT_DIRS=/Users/you/Belege:/Users/you/Downloads

# SEVDESK_BASE_URL=https://my.sevdesk.de/api/v1
# SEVDESK_TIMEOUT_MS=30000
# SEVDESK_MAX_RETRIES=3
# SEVDESK_RATE_LIMIT=4

# Log `METHOD /path -> status` to stderr. Never logs the token or bodies.
# SEVDESK_DEBUG=false

# ---------------------------------------------------------------------------
# Remote transport (Streamable HTTP). Unused over stdio.
# ---------------------------------------------------------------------------

# oauth | none. No default in production: a deployment must say what it wants,
# so an unset value there refuses every request instead of serving anonymously.
# MCP_AUTH_MODE=none

# Required with MCP_AUTH_MODE=oauth.
# MCP_OAUTH_ISSUER=https://your-tenant.example.com
# MCP_OAUTH_AUDIENCE=https://your-deployment.example.com/mcp

# Optional: discovered from the issuer's metadata when unset.
# MCP_OAUTH_JWKS_URI=

# Optional: space- or comma-separated scopes every token must carry.
# MCP_OAUTH_SCOPES=

# Your canonical /mcp URL. Also the default Host/Origin allowlist, so set it
# when the deployment answers on a custom domain.
# MCP_PUBLIC_URL=https://your-deployment.example.com/mcp

# Comma-separated hostname allowlists, when MCP_PUBLIC_URL is not enough.
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=

# Local HTTP dev server only (scripts/serve-http.mjs).
# HOST=127.0.0.1
# PORT=3000
